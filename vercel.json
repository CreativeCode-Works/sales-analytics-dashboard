{
  "rewrites": [
    { "source": "/sales", "destination": "/index.html" },
    { "source": "/sales/(.*)", "destination": "/index.html" }
  ],
  "outputDirectory": "src",
  "buildCommand": "echo 'Static site - no build needed'",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
